# Docker Compose reads this file only after copying it to .env.
# IntelliJ/Maven must receive the same values through Run Configuration / terminal.
DB_PASSWORD=Replace-With-A-Strong-Local-Password!2026
ADMIN_PASSWORD=Replace-With-A-Different-Admin-Password!2026
ADMIN_USERNAME=admin
SEED_DEMO=true
# Optional new backend integrations. IntelliJ/Maven must receive these explicitly.
SHIPPING_FEE=0
SHIPPING_FREE_ABOVE=2000000
OTP_ENABLED=false
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/return
